<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0"
          xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
  <assemblyIdentity
      type="win32"
      name="TickScope"
      version="1.0.0.0"
  />
  <asmv3:application>
    <asmv3:windowsSettings>
      <!-- Per-Monitor V2 DPI awareness with fallback to Per-Monitor V1.
           This ensures DPI awareness is set at process creation time (before
           any windows are created), which is required for correct DWM
           non-client area scaling and smooth cross-monitor transitions.
           winit also sets this at runtime, but the manifest takes precedence
           and ensures consistent behavior from process start. -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2,PerMonitor</dpiAwareness>
    </asmv3:windowsSettings>
  </asmv3:application>
</assembly>
