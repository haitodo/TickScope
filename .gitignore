# Rust build artifacts
target/
# Build cache used when target/ is not writable (CARGO_TARGET_DIR=.clippy-target).
# Must stay ignored: committing it once added ~10k build artifacts to a commit.
.clippy-target/
**/*.rs.bk
*.pdb

# Runtime data & logs
data/
*.tlog
*.log

# MetaTrader 5 compiled executables and logs
*.ex5
*.mqproj

# IDE & Editor configs
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.bak

# OS specific files
Thumbs.db
[Dd]esktop.ini
.DS_Store
